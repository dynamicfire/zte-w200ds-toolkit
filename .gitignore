# 构建产物（用 ./build.sh 或 ./scripts/build-apm.sh 生成）
/build/
*.apk
*.aab
*.apks
*.idsig
*.dex
*.class
*.img
*.bin
*.log

# Ubuntu/KVM 的磁盘、固件变量、seed、运行态和本机身份
*.qcow2
*.iso
*.fd
*.raw
*.snap
*.sock
*.pid
*.before-*
known_hosts*
*_ed25519*
config.local
/tools/ubuntu-kvm/local/
/tools/ubuntu-kvm/state/
/tools/ubuntu-kvm/secrets/
/tools/ubuntu-kvm/artifacts/
/tools/ubuntu-kvm/work/
/tools/ubuntu-kvm/**/*.lock
/tools/ubuntu-kvm/**/config
/tools/ubuntu-kvm/**/authorized_keys
/tools/ubuntu-kvm/**/id_*
/tools/ubuntu-kvm/cloud-init/user-data
/tools/ubuntu-kvm/cloud-init/meta-data
/tools/ubuntu-kvm/cloud-init/network-config

# 签名密钥绝不能入库
/signing/
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
.env

# Android Studio / 本机配置
local.properties
.idea/
.gradle/

# 杂项
.DS_Store

# Installer Fix 调查/构建时可能产生的设备专有文件
/xposed/zte_installer_fix/build/
/xposed/zte_installer_fix/signing/
/xposed/zte_installer_fix/framework.jar
/xposed/zte_installer_fix/framework-dex/
/xposed/zte_installer_fix/backups/
/xposed/zte_installer_fix/probe/
/xposed/zte_installer_fix/*.png
